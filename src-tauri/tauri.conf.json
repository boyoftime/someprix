{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Someprix",
  "version": "1.9.0",
  "identifier": "com.someprix.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Someprix",
        "width": 1160,
        "height": 720,
        "minWidth": 900,
        "minHeight": 580,
        "center": true,
        "decorations": false,
        "shadow": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzMTZFOEQzRTQ2Mzk2QjkKUldTNWxtUGswK2dXMDJyVDJXQWRNNlVHK0d1WlJrTnJPdU5WdnRLaGNzd2s4SGJBWWhwNFRVMjMK",
      "endpoints": [
        "https://github.com/boyoftime/someprix/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
